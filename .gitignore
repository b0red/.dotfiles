.bashrc.d/local_alias.bash
.bashrc.d/extra_alias.bash

#Ignore logs
**/logs
*.log
*.swp
a.txt
.gitsecret/keys/random_seed
!*.secret
backup-*

# Ignore folders
extras/
oldfiles/
old-files/

# Machine-specific app lists (optional)
.install_apps.inc.local

# Machine-specific config files (optional)
.config/kitty/kitty.conf.local

# Installer-generated runtime state (was previously mistyped as
# ~/dotfiles/.installation-state, which never matched — fixed 2026-08-06)
.installation-state

# Claude Code working directory
.claude/

# vs workspace settings
.dotfiles.code-workspace
dotfiles.code-workspace

# Stale installer/editor-generated backups that shouldn't be committed
tmux/.tmux.conf.bak-*
tmux/.tmux.conf.[0-9]*
tmux/*.old

# Coffee-managed tmux plugins — installed/updated by Coffee, not tracked here.
# One wildcard so a newly added plugin needs no .gitignore edit. The *.yaml files next
# to them ARE tracked (they tell Coffee what to install), and so is tmux-ip-toggle/,
# our own plugin that Coffee doesn't manage (loaded directly from .tmux.conf).
tmux/coffee/plugins/*/
!tmux/coffee/plugins/tmux-ip-toggle/

# vim-plug-managed plugins — installed/updated via :PlugInstall, not tracked here.
vim/plugged/*/

# Ignore packed files
*.rar
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.7z