tmux/coffee/plugins/tmux-continuum/
tmux/coffee/plugins/tmux-cpu/
tmux/coffee/plugins/tmux-menus/
tmux/coffee/plugins/tmux-nerd-font-window-name/
tmux/coffee/plugins/tmux-online-status/
tmux/coffee/plugins/tmux-power-zoom/
tmux/coffee/plugins/tmux-prefix-highlight/
tmux/coffee/plugins/tmux-resurrect/
