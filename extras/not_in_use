function yes_no() {
    echo "Do you wish to clone the dotfiles-repo?"
    select yn in "Yes" "No"; do
    case $yn in
        Yes ) git clone git@bitbucket.org:b0red/dotfiles.git ~/dotfiles; 
        echo "Cloning repo 'git@bitbucket.org:b0red/dotfiles.git'" > $LOG
        break
        ;;
        No ) 
        exit 0
        ;;
    esac
done
}

function info () {
  printf "\r  [ \033[00;34m..\033[0m ] $1\n"
}

function user () {
  printf "\r  [ \033[0;33m??\033[0m ] $1\n"
}

function success () {
  printf "\r\033[2K  [ \033[00;32mOK\033[0m ] $1\n"
}

function fail () {
  printf "\r\033[2K  [\033[0;31mFAIL\033[0m] $1\n"
  echo ''
  exit
}

###     Install or update
#
printf "Do You want to install or update 'dotfiles'"
read question
case $question in
    Install|install )
        echo "Doing installation!"
        exit 0
        ;;
    Update|update)
        echo "Doing a upgrade!"
        exit 0
        ;;
    *)
        echo "Noting chosen!"
        exit 0
        ;;
esac

    ### Move old .dotfiles to backupfolder and archive them
    #   skip symlinked files
    #
    cat $OLDFILES | while read FILE ; 
    do 
        # Symlink check
        # [[ -L $HOME/$FILE ]] && echo symlink || echo not symlink
        if [[ ! -f $HOME/$FILE ]]; then
            echo "$FILE does not exist"
            # MVSTATUS="$FILE copied to $DIR/$HOSTNAME"
        else
            [[ -L $HOME/$FILE ]] && echo "$FILE is a symlink, not moved!" || cp $FILE $DIR/$HOSTNAME;
        fi
    done

