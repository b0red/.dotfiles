#!/bin/bash
# =============================================================================
# TMUX SESSION STARTUP SCRIPT
# =============================================================================
# Creates a tmux session with panes:
# - Left pane (50%): Full height, starts in ~/bin (or ~)
# - Top-right pane (60% of right side): Starts in ~/docker/compose (or ~)
# - Middle-right pane: Runs mc if available
# - Bottom-right pane: Runs task if available
# =============================================================================
# NOTE: This script assumes pane-base-index 1 in .tmux.conf
# =============================================================================
#
# Version 5.0 / 2026-01-27

# -----------------------------------------------------------------------------
# 1. NESTING GUARD: Don't run if already inside tmux
# -----------------------------------------------------------------------------
[ -n "$TMUX" ] && exit 0

# Set session name to current nodename
SESSION_NAME="$(uname -s | tr '[:upper:]' '[:lower:]')"
#SESSION_NAME="main"

# -----------------------------------------------------------------------------
# 2. DETERMINE STARTING DIRECTORIES
# -----------------------------------------------------------------------------
# Left pane: Use ~/bin if it exists, otherwise use home directory
if [ -d "$HOME/bin" ]; then
  LEFT_DIR="$HOME/bin"
else
  LEFT_DIR="$HOME"
fi

# Top-right pane: Use ~/docker/compose if it exists, otherwise use home directory
# Bottom-right also uses TOP_RIGHT_DIR
if [ -d "$HOME/docker/compose" ]; then
  TOP_RIGHT_DIR="$HOME/docker/compose"
else
  TOP_RIGHT_DIR="$HOME"
fi

# -----------------------------------------------------------------------------
# 3. ATTACH TO EXISTING SESSION IF IT EXISTS
# -----------------------------------------------------------------------------
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
  tmux attach-session -t "$SESSION_NAME"
  exit 0
fi

# -----------------------------------------------------------------------------
# 4. CREATE NEW SESSION (detached) - This creates pane 1 (left)
# -----------------------------------------------------------------------------
tmux new-session -s "$SESSION_NAME" -d -c "$LEFT_DIR"

# -----------------------------------------------------------------------------
# 5. BUILD THE LAYOUT
# -----------------------------------------------------------------------------
# First split: Create right pane (pane 2) with vertical divider
# -h creates a vertical divider (left | right layout)
# After this split, pane 2 (right) becomes the ACTIVE pane
# With pane-base-index 1: we now have pane 1 (left) and pane 2 (right)
tmux split-window -h -c "$TOP_RIGHT_DIR"

# Second split: Split pane 2 (right pane) horizontally (top / bottom)
# -v creates a horizontal divider (top / bottom layout)
# -p 40 means the NEW pane (bottom-right, becomes pane 3) gets 40% height
# This leaves pane 2 (top-right) with 60% height
# After this split: pane 1 (left), pane 2 (top-right), pane 3 (middle-right)
tmux split-window -v -p 40 -c "$TOP_RIGHT_DIR"

# Optional: If task is installed, split pane 3 (middle-right) to create pane 4 (task) at bottom
# -p 10 means the NEW pane (task, becomes pane 4) gets 10% height, mc keeps 90%
# After this split: pane 1 (left), pane 2 (top-right), pane 3 (middle-right/mc), pane 4 (bottom-right/task)
# Adjust -p value to change task pane size (e.g., -p 20 for 20% height, -p 30 for 30% height)
if command -v task >/dev/null 2>&1; then
  tmux split-window -v -p 10 -c "$TOP_RIGHT_DIR"
fi

# -----------------------------------------------------------------------------
# 6. WAIT FOR PANES TO INITIALIZE
# -----------------------------------------------------------------------------
# Small delay to ensure all panes have fully initialized their shells
# This prevents race conditions where send-keys executes before shell is ready
sleep 0.5

# -----------------------------------------------------------------------------
# 7. SET UP EACH PANE WITH COMMANDS (Moved BEFORE attach for execution guarantee)
# -----------------------------------------------------------------------------
# Pane 1 (left pane): Clear the screen
tmux send-keys -t 1 "clear" C-m

# Pane 2 (top-right pane): Clear the screen
tmux send-keys -t 2 "clear" C-m

# Pane 3 (middle-right pane): Launch mc (Midnight Commander) if available
if command -v mc >/dev/null 2>&1; then
  tmux send-keys -t 3 "mc" C-m
else
  tmux send-keys -t 3 "clear" C-m
fi

# Pane 4 (bottom-right pane): Launch task if available (only if pane was created)
if command -v task >/dev/null 2>&1; then
  tmux send-keys -t 4 "task" C-m
fi

# -----------------------------------------------------------------------------
# 8. FOCUS MC PANE (pane 3) AND ATTACH TO SESSION
# -----------------------------------------------------------------------------
tmux select-pane -t 3
tmux attach-session -t "$SESSION_NAME"