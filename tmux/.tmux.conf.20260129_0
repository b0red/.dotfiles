# -----------------------------------------------------------------------------

# RELOAD CONFIG:
# From inside tmux: Press <Prefix / ctrl + a> then : source-file ~/.tmux.conf
# From shell: tmux source-file ~/.tmux.conf
# -----------------------------------------------------------------------------
bind r source-file ~/.tmux.conf \; display "Config reloaded!"

# Set the default prefix key to Ctrl-a (Ctrl-b is the default)
# unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Set terminal capabilities for 256 colors and RGB support
set -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-256color:RGB"

# -----------------------------------------------------------------------------
# CORE SETTINGS & MOUSE (Fixes Warp Pane Copy Issue)
# -----------------------------------------------------------------------------

# Enable mouse mode for selecting panes, resizing, and scrolling
set -g mouse on

# Set vi-like keybindings in copy mode
set-window-option -g mode-keys vi

# Note on Copying: To copy text correctly across pane boundaries, DO NOT use
# Shift+Mouse drag. Instead, use the tmux copy mode:
# 1. Press <Prefix> + [ (Enter Copy Mode)
# 2. Press Space (Start selection)
# 3. Select text using cursor keys or mouse drag (Pane boundaries respected!)
# 4. Press 'y' (Copy/Yank to system clipboard via tmux-yank plugin)

# Fix Warp/Terminal Clipboard: Removing the custom terminal-override that caused conflicts.
# #set -g terminal-overrides ",xterm-256color:Ms=\\E[<0;*M" (Removed)

# Set history limit for scrollback buffer
set -g history-limit 50000

# -----------------------------------------------------------------------------
# WINDOW & PANE MANAGEMENT
# -----------------------------------------------------------------------------

# Start index counting at 1 (more intuitive than 0)
set-option -g base-index 1
set -g pane-base-index 1
setw -g pane-base-index 1

# Automatically rename windows based on content
set-window-option -g automatic-rename on
set-option -g set-titles on

# Renumber windows sequentially when a window is closed
set -g renumber-windows on

# Open new windows in the current pane's path
bind c new-window -c "#{pane_current_path}"

# Split vertically/horizontally in the current pane's path
bind | split-window -h -c "#{pane_current_path}" # Horizontal split
bind - split-window -v -c "#{pane_current_path}" # Vertical split

# Toggle synchronization (input to all panes in a window)
bind-key e setw synchronize-panes

# Switch to the last window
bind-key C-s last-window
bind-key C-a last-window # Also bind 'C-a' to switch to last window

# Rename the current window
bind , command-prompt "rename-window '%%'"

# Kill the current window with confirmation
bind-key X confirm-before -p "kill-window #W? (y/n)" kill-window

# Detach session
bind-key d detach

# Open man page in a new window
bind m command-prompt "split-window 'exec man %%'"

# Sidebar/Tree Listing Plugin Binding
set -g @sidebar-tree 'Tab'
bind-key Tab run-shell "~/.tmux/plugins/tmux-sidebar/scripts/toggle" # Default path for sidebar

# Tmux menus
run-shell ~/.tmux/plugins/tmux-menus/menus.tmux

# this might not work (20260115)
# Integrate with system clipboard
set -g set-clipboard on
# Allow passthrough for OSC sequences (for better clipboard and title integration)
set -g allow-passthrough on

# -----------------------------------------------------------------------------
# CUSTOM SHORTCUTS
# -----------------------------------------------------------------------------
# # Custom shortcuts
# bind -n C-e new-window -c "#{pane_current_path}" -n 'editor' "$EDITOR"
# bind -n M-e new-window -c "$HOME" -n 'dotfiles' "yadm enter $EDITOR"
bind -n C-b new-window -n 'btop' 'btop'

# # smart lazygit
# bind -n C-g popup -d '#{pane_current_path}' -E -w 90% -h 90% fish -c 'gg'

# -----------------------------------------------------------------------------
# KEYBOARD NAVIGATION
# -----------------------------------------------------------------------------

# Switch panes using Alt-arrow without prefix
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# -----------------------------------------------------------------------------
# URL HANDLING
# -----------------------------------------------------------------------------

# Capture pane content and open URL browser (requires urlview)
bind u capture-pane \; save-buffer /tmp/tmux-buffer \; new-window -n "urlview" '$SHELL -c "urlview < /tmp/tmux-buffer"'

# -----------------------------------------------------------------------------
# NOTIFICATIONS & VISUALS
# -----------------------------------------------------------------------------

# Highlight windows when activity occurs
set -g monitor-activity on
set -g visual-activity on
set -g message-style 'fg=yellow'    # Message style for notifications

# Clock mode color
set-window-option -g clock-mode-colour colour64 # Green

# Set up character set overrides for line drawing (often needed on remote hosts)
set-option -ga terminal-overrides ',*:enacs@:smacs@:rmacs@:acsc@'

# -----------------------------------------------------------------------------
# STATUS BAR (THEME)
# -----------------------------------------------------------------------------

# Status bar style and refresh
set -g status-interval 5                    # Interval in seconds (5)
set -g status-bg black                      # Status background
set -g status-fg white                      # Status foreground
set -g status-justify left                  # Justify left
set -g status-left-length 120               # Left length
set -g status-right-length 140              # Right length

# Window Title Bar (Status Line 0 - Above the status bar)
# Shows prefix highlight, current user, host, and public IP address
set -g set-titles-string ' #{prefix_highlight} #(whoami) | #h | #(curl -s ipecho.net/plain;echo)'

# Highlight the current window's title
set -g window-status-current-format "#[bg=white,fg=black,bold]#I:#W#[default]"

# Status Bar Left: [Online Status | Date/Time |Mem/Cpu-load] / [Repo | branch: status ]
set -g status-left ' Online: #{online_status} #[default]#[fg=white]| #[fg=white]%Y-%m-%d (#[fg=grey]%H:%M#[default])'

# Status Bar Right: [ Prefix Highlight | CPU | RAM | User | Host | WAN IP ]
set -g status-right ' #{prefix_highlight} | #{forecast}|#{cpu_bg_color}CPU:#{cpu_icon}#{cpu_percentage} #[default]#[fg=white]|#{ram_bg_color}RAM:#{ram_icon} #{ram_percentage} #[default]#[fg=white]| #[fg=Green]#(whoami)#[fg=white] | #[fg=grey]#(hostname -s)#[fg=white] | #[fg=yellow]WAN:#(curl -4s https://ipecho.net/plain || curl -4s https://ifconfig.me || echo "n/a") '

# -----------------------------------------------------------------------------
# PLUGIN ICONS & CONFIGURATION
# -----------------------------------------------------------------------------

# set -g @online_icon "#[fg=green]Yes"
# set -g @offline_icon "#[fg=orange]No"
set -g @batt_charged_icon "✔"
set -g @batt_charging_icon "⚡"
set -g @batt_attached_icon "🔌"
set -g @batt_full_charge_icon "🌕 "
set -g @batt_high_charge_icon "🌖 "
set -g @batt_medium_charge_icon "🌗 "
set -g @batt_low_charge_icon "🌘 "

# Wttr format
set -g @forecast-format '%C'+'|'+'Dusk:'+'%d'
set -g @forecast-location stockholm
set -g @forecast-language "sv"
set -g @forecast-cache-duration 1800            # 30 minutes

# Specific Plugin Configurations
set -g @continuum-restore 'on'                  # Enable automatic restore of sessions
set -g @continuum-boot 'on'
set -g @sidebar-tree-command 'tree -C'          # Colorise sidebar tree listing

# -----------------------------------------------------------------------------
# PLUGINS (TPM: Tmux Plugin Manager)
# -----------------------------------------------------------------------------

set -g @plugin 'tmux-plugins/tpm'                       # Tmux Plugin Manager
set -g @plugin 'jaclu/tmux-menus'                       # Menus for various tasks
set -g @plugin 'joshmedeski/tmux-nerd-font-window-name' # Show window name with nerd font icons
set -g @plugin 'jaclu/tmux-power-zoom'                  # Zoom in/out of panes
set -g @plugin 'tmux-plugins/tmux-resurrect'            # Save/restore sessions
set -g @plugin 'tmux-plugins/tmux-continuum'            # Automatic restore & continuous saving
set -g @plugin 'tmux-plugins/tmux-online-status'        # Show online/offline status
set -g @plugin 'tmux-plugins/tmux-sidebar'              # Tree directory listing
set -g @plugin 'tmux-plugins/tmux-battery'              # Show battery status
set -g @plugin 'tmux-plugins/tmux-prefix-highlight'     # Highlight prefix status
set -g @plugin 'tmux-plugins/tmux-cpu'                  # Another Cpu/Mem plugin
set -g @plugin 'aaronpowell/tmux-weather'               # Weather status
#set -g @net_speed_interfaces "eth0"                     # Network speed monitor (change 'eth0' to your interface, multiple separated by space)

#set -g @plugin 'thewtex/tmux-mem-cpu-load'              # Set cpu-load in left status
#set -g @plugin 'erikw/tmux-powerline'                   # Power line
#set -g @plugin 'tmux-plugins/tmux-sensible'             # Sensible defaults
#set -g @plugin 'tmux-plugins/tmux-yank'                 # *** ADDED: CRUCIAL for system copy/paste (y key in copy mode) ***
#set -g @plugin 'b0o/tmux-autoreload'                    # Auto reload config on change / not working, needs "entr"

# -----------------------------------------------------------------------------
# INITIALIZE TPM (MUST BE AT THE VERY BOTTOM)
# *** FIXED: The original 'if' line is now syntactically correct for tmux ***
# -----------------------------------------------------------------------------

# Auto-install TPM if it's missing (requires git).
# If the 'test' command is successful (TPM is NOT installed), it executes the 'run' command.
# The '&& ~/.tmux/plugins/tpm/bin/install_plugins' ensures plugins are installed immediately after cloning.
if "test ! -d $HOME/.tmux/plugins/tpm" "run 'git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm && $HOME/.tmux/plugins/tpm/bin/install_plugins'"
# # OR:
# if test ! -d $HOME/.tmux/plugins/tpm; then
#     run 'git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm'
#     $HOME/.tmux/plugins/tpm/bin/install_plugins
# fi
# Initialize TPM. This MUST be the last line to execute all plugin 'run' commands.
run '$HOME/.tmux/plugins/tpm/tpm'